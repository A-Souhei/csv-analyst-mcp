# host port for the MCP server + webui
PORT=41733

# comma-separated list of dataset directories to expose to the server, format:
#   /absolute/host/path[:name]
# each entry is mounted read-only at /mnt/<name> (name defaults to the directory
# name) and is browsable in the webui — add what you want listed under Sources
CSV_SOURCES=/absolute/path/to/datasets,/absolute/path/to/more-data:short-name

# tailscale auth key for the ts-csv-analyst sidecar, which serves the container
# at https://csv-analyst.<your-tailnet>.ts.net — leave empty to skip the sidecar
TS_AUTHKEY=

# base URL used in the links returned by the visualize tool
# (leave empty for relative paths; set it to your own tailnet or LAN address)
PUBLIC_BASE_URL=

# what PII values are replaced with before any EDA code runs
REDACTION_MASK=***

# local LLM for classify_pii_local, the viewer's Ask box and join planning
# (any OpenAI-compatible endpoint). Pointing at llama-swap reuses the model it
# already has loaded rather than making Ollama load a second copy.
LOCAL_LLM_URL=http://host.docker.internal:41573/upstream/<model>/v1
LOCAL_LLM_MODEL=<model>
# Ollama alternative: http://host.docker.internal:11434/v1 with the ollama tag as the model
